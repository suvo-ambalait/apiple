{
    "name": "suvo-ambalait/apiple",
    "description": "A clean, Postman-style API reference page for Laravel projects. Reads any OpenAPI JSON (l5-swagger, Scribe, ...) and adds a collapsible menu, Try it, login helper, code snippets and Postman export.",
    "keywords": ["laravel", "api", "documentation", "openapi", "swagger", "postman"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0",
        "illuminate/contracts": "^11.0|^12.0"
    },
    "suggest": {
        "darkaonline/l5-swagger": "Generates the OpenAPI JSON this page reads from Swagger annotations."
    },
    "autoload": {
        "psr-4": {
            "Suvo\\Apiple\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Suvo\\Apiple\\ApiReferenceServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
